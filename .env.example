# DESIGN-STAGE CONFIGURATION CONTRACT. No running application reads this yet.
# Copy to .env for local implementation. Never commit real credentials.
# Names and values must be verified when ECR-21/22/23 implement configuration.

# Server: backend only.
CYBERSEAT_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
APP_SECRET_KEY=REPLACE_WITH_A_LOCALLY_GENERATED_SECRET

# PostgreSQL: backend only. These are placeholders, not provisioned accounts.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cyberseat_dev
DATABASE_USER=cyberseat_dev
DATABASE_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD

# A separate database for integration tests; never point tests at real club data.
TEST_DATABASE_NAME=cyberseat_test

# Public browser configuration. VITE_ values are exposed to the browser bundle.
# Never put database passwords, secret keys or private tokens in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:8000/api/v1
